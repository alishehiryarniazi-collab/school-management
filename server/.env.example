# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

DEFAULT_STUDENT_PASSWORD=school123

# Keep false for local / LAN use over HTTP. Set true only behind HTTPS.
COOKIE_SECURE=false
